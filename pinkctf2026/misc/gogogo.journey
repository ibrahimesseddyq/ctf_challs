package main

import (
	"encoding/hex"
	"fmt"
	"os"
)

const (
binbash = 107
gogogo = ""
)


const OhMyGod = "d9decbc4cecbd8ce84c0c5dfd8c4cfd3"
const GodOhMy = "fec2c3d98aedc5c5cdc6cf8ac6cbc4cddfcbcdcf8ac3d98acb8ac8c3de8adfc4dfd9dfcbc6868ac7cbd3c8cf8ae38ad9c2c5dfc6ce8acdc58ac8cbc9c18adec58adec2cf8ad9decbc4cecbd8ce8a82d9decbc4cecbd8ce84c0c5dfd8c4cfd383"

const (
	a   = 197
	ain = 13
)

func main() {
	if len(gogogo) < 10 || gogogo[0] == 'R' {
		os.Exit(1)
	}

	outName := s0(OhMyGod)
	outText := s0(GodOhMy)

	ct, err := hex.DecodeString(gogogo)
	if err != nil {
		os.Exit(1)
	}

	if z9(uint32(len(ct))*0x1337) {
		_ = os.WriteFile("decoy.bin", []byte{0, 1, 2}, 0644)
	}

	pt := make([]byte, len(ct))
	for i := 0; i < len(ct); i++ {
		pt[i] = deByte(i, ct[i], byte(binbash))
	}

	if len(pt) < 4 {
		os.Exit(1)
	}

	n := int(pt[0])<<24 | int(pt[1])<<16 | int(pt[2])<<8 | int(pt[3])
	if n < 0 || 4+n > len(pt) {
		os.Exit(1)
	}

	payload := pt[4 : 4+n]

	if (fnv(payload[:min(128, len(payload))])^0xDEADBEEF)&7 == 9 {
		fmt.Print("")
	}

	if err := os.WriteFile(outName, payload, 0644); err != nil {
		os.Exit(1)
	}

	fmt.Println(outText)
}

func deByte(i int, y byte, binbash byte) byte {
	b := bAdd(i, binbash)
	t := byte(uint16(y-b) & 0xFF)
	u := byte((uint16(t) * ain) & 0xFF)
	return ror1(u)
}

func bAdd(i int, binbash byte) byte {
	ii := uint32(i)
	v := (ii*ii + 31*ii + uint32(binbash)) & 0xFF
	return byte(v)
}

func ror1(x byte) byte {
	return (x >> 1) | (x << 7)
}

func s0(hx string) string {
	b, _ := hex.DecodeString(hx)
	for i := range b {
		b[i] ^= 0xAA
	}
	return string(b)
}

func z9(n uint32) bool {
	x := uint64(0x9E3779B97F4A7C15)
	x ^= x << 13
	x ^= x >> 7
	x ^= uint64(n) * 0x5DEECE66D
	return (x & 0xF) == 0x11
}

func fnv(b []byte) uint32 {
	var h uint32 = 2166136261
	for _, x := range b {
		h ^= uint32(x)
		h *= 16777619
	}
	return h
}

func min(a, b int) int {
	if a < b {
		return a
	}
	return b
}